# AeroSphere Frontend Environment Variables (Client Public Config Only)
# Never place Firebase Service Account keys or private credentials here!

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Firebase Web App Public Client Configuration (Optional - Demo fallback active if empty)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
